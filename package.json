{
  "name": "shakti-new-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:cloudflare": "npx --yes --package node@22 --call './node_modules/.bin/opennextjs-cloudflare build'",
    "preview:cloudflare": "npx --yes --package node@22 --call './node_modules/.bin/opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true ./node_modules/.bin/wrangler dev --config wrangler.jsonc'",
    "deploy:cloudflare": "npx --yes --package node@22 --call './node_modules/.bin/opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true ./node_modules/.bin/wrangler deploy --config wrangler.jsonc'",
    "cf-typegen": "npx --yes --package node@22 --call './node_modules/.bin/wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts'"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.453.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "wrangler": "4.127.1"
  }
}
